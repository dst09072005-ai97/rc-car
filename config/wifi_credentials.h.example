#pragma once

// ============================================================================
// CẤU HÌNH THÔNG TIN WI-FI / ĐIỂM PHÁT SÓNG 4G CHO MẠCH XE & CAMERA ESP32
// HƯỚNG DẪN: Sao chép tệp này thành wifi_credentials.h trong cùng thư mục
//            hoặc trong config/ để nạp vào mạch ESP32.
// CẢNH BÁO: KHÔNG commit tệp wifi_credentials.h chứa thông tin Wi-Fi thật lên Git!
// ============================================================================
// 1. CÁCH KẾT NỐI QUA HOTSPOT ĐIỆN THOẠI (4G):
//    Trên điện thoại, vào Cài đặt -> Điểm phát sóng cá nhân (Hotspot):
//    - Đặt Tên Wi-Fi (SSID) và Mật khẩu tương ứng với cấu hình bên dưới.
//    -> Khi bật Hotspot lên, mạch xe, cam trước, cam lùi, laptop và kính VR
//       sẽ tự động nhận diện và kết nối.
//
// 2. TỰ ĐỘNG DỰ PHÒNG 2 MẠNG:
//    Mạch sẽ tự động thử kết nối mạng chính (WIFI_SSID / WIFI_PASS), nếu không
//    thấy sẽ tự động kết nối sang mạng Hotspot dự phòng (WIFI_BACKUP_SSID).
// ============================================================================

#ifndef WIFI_SSID
#define WIFI_SSID "YOUR_PRIMARY_WIFI_SSID"
#endif

#ifndef WIFI_PASS
#define WIFI_PASS "YOUR_PRIMARY_WIFI_PASSWORD"
#endif

#ifndef WIFI_BACKUP_SSID
#define WIFI_BACKUP_SSID "YOUR_BACKUP_HOTSPOT_SSID"
#endif

#ifndef WIFI_BACKUP_PASS
#define WIFI_BACKUP_PASS "YOUR_BACKUP_HOTSPOT_PASSWORD"
#endif
