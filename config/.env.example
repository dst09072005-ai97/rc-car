# ==============================================================================
# XE RC FPV V10 - Environment Configuration Template
# Hướng dẫn: Sao chép tệp này thành config/.env và tùy biến cho hệ thống của bạn.
# CẢNH BÁO BẢO MẬT: TUYỆT ĐỐI KHÔNG commit tệp config/.env chứa secret thật lên Git!
# ==============================================================================

# Server Web Ports (Mặc định: 8080 HTTP, 8443 HTTPS WebXR)
PORT=8080
HTTPS_PORT=8443

# Cấu hình Tên miền & SSL DuckDNS (Tùy chọn - Dành cho FPV Cam điện thoại & Remote)
DUCKDNS_DOMAIN=vr-cam-fpv
DUCKDNS_TOKEN=your-duckdns-token-here

# Public Tunnel URL (Tùy chọn - Cloudflare / ngrok tunnel)
PUBLIC_TUNNEL_URL=

# Cấu hình Phần cứng Xe RC & Camera ESP32 (Theo dải IP Wi-Fi LAN / Hotspot)
ESP32_FRONT_CAM_IP=192.168.1.101
ESP32_FRONT_CAM_PORT=81
ESP32_FRONT_CAM_PATH=/stream

ESP32_REAR_CAM_IP=192.168.1.102
ESP32_REAR_CAM_PORT=81
ESP32_REAR_CAM_PATH=/stream

ESP32_CTRL_IP=192.168.1.100
ESP32_CTRL_UDP_PORT=4210
ESP32_CTRL_HTTP_PORT=80

ESP32_CONTROLLER_HOST=192.168.1.238
ESP32_CONTROLLER_UDP_PORT=4210

# SoundCloud API Client ID (Tùy chọn - Nhạc táp-lô trong buồng lái xe)
SOUNDCLOUD_CLIENT_ID=
