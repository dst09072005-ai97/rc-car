// ============================================================================
// CẤU HÌNH THÔNG TIN WI-FI / ĐIỂM PHÁT SÓNG 4G CHO MẠCH XE & CAMERA ESP32
// ============================================================================
// 1. CÁCH KẾT NỐI NGAY KHÔNG CẦN CẮM CÁP NẠP LẠI CODE (KHUYÊN DÙNG - 10 GIÂY):
//    Trên điện thoại của bạn, vào Cài đặt -> Điểm phát sóng cá nhân (Hotspot 4G):
//    - Đặt Tên Wi-Fi (SSID): BETEA
//    - Đặt Mật khẩu: daihongbao
//    -> Khi bật 4G Hotspot lên, mạch xe, cam trước, cam lùi, laptop và kính VR
//       sẽ lập tức tự động nhận diện và kết nối ngay trong 5 giây!
//
// 2. NẾU NẠP LẠI CODE BẰNG ARDUINO IDE:
//    Mạch sẽ tự động thử kết nối mạng chính ("BETEA" / "daihongbao"), nếu không
//    thấy sẽ tự động kết nối sang mạng Hotspot dự phòng ("Maximus" / "12345678").
// ============================================================================

#ifndef WIFI_SSID
#define WIFI_SSID "BETEA"
#endif

#ifndef WIFI_PASS
#define WIFI_PASS "daihongbao"
#endif

#ifndef WIFI_BACKUP_SSID
#define WIFI_BACKUP_SSID "Maximus"
#endif

